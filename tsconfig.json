{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",  // Dossier de sortie pour le JavaScript compilé
    "rootDir": "./src"   // Dossier source contenant les fichiers TypeScript
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
